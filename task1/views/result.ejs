<!DOCTYPE html>
<html lang="en">
<head>
    <title><%= title %></title>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <style>
        :root {
            --bg: #f4f7fb;
            --surface: #ffffff;
            --surface-soft: #f8fbff;
            --border: #dbe4f0;
            --text: #102033;
            --muted: #5f7187;
            --accent: #2563eb;
            --accent-hover: #1d4ed8;
            --shadow: 0 18px 50px rgba(16, 32, 51, 0.08);
        }

        * { box-sizing: border-box; }

        body {
            margin: 0;
            min-height: 100vh;
            font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
            background: linear-gradient(180deg, #eef4ff 0%, var(--bg) 100%);
            color: var(--text);
            padding: 32px 18px;
        }

        .page {
            width: min(100%, 1040px);
            margin: 0 auto;
            display: grid;
            grid-template-columns: 0.95fr 1.05fr;
            gap: 24px;
            align-items: stretch;
        }

        .site-header {
            width: min(100%, 1040px);
            margin: 0 auto 18px;
            background: rgba(255, 255, 255, 0.88);
            border: 1px solid var(--border);
            border-radius: 16px;
            box-shadow: var(--shadow);
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 14px 18px;
            backdrop-filter: blur(10px);
        }

        .brand {
            display: flex;
            flex-direction: column;
            gap: 4px;
        }

        .brand strong {
            font-size: 1rem;
            letter-spacing: -0.02em;
        }

        .brand span {
            font-size: 0.88rem;
            color: var(--muted);
        }

        .nav-pill {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 10px 14px;
            border-radius: 999px;
            background: #eef4ff;
            color: var(--accent);
            font-size: 0.9rem;
            font-weight: 600;
        }

        .summary, .card {
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: 24px;
            box-shadow: var(--shadow);
        }

        .summary {
            padding: 34px;
            background:
                radial-gradient(circle at top right, rgba(37, 99, 235, 0.09), transparent 30%),
                linear-gradient(180deg, #ffffff, #f8fbff);
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            gap: 18px;
        }

        .badge {
            display: inline-flex;
            width: fit-content;
            padding: 8px 12px;
            border-radius: 999px;
            background: #e8f0ff;
            color: var(--accent);
            font-size: 0.88rem;
            font-weight: 700;
        }

        h1 {
            margin: 0;
            font-size: clamp(2rem, 4vw, 3.4rem);
            line-height: 1.04;
            letter-spacing: -0.04em;
        }

        .summary p {
            margin: 0;
            color: var(--muted);
            line-height: 1.75;
        }

        .card {
            padding: 30px;
            background: var(--surface-soft);
        }

        .card h2 {
            margin: 0 0 18px;
            font-size: 1.4rem;
        }

        .detail {
            display: grid;
            gap: 14px;
        }

        .row {
            padding: 16px 18px;
            border-radius: 16px;
            background: #fff;
            border: 1px solid var(--border);
        }

        .label {
            display: block;
            margin-bottom: 8px;
            color: var(--muted);
            font-size: 0.88rem;
            text-transform: uppercase;
            letter-spacing: 0.08em;
        }

        .value {
            font-size: 1.04rem;
            word-break: break-word;
        }

        .toolbar {
            display: flex;
            flex-wrap: wrap;
            gap: 12px;
            margin-top: 20px;
        }

        a.button {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            padding: 13px 18px;
            border-radius: 12px;
            text-decoration: none;
            font-weight: 700;
            color: white;
            background: var(--accent);
            transition: transform 160ms ease, background 160ms ease;
        }

        a.button:hover {
            background: var(--accent-hover);
            transform: translateY(-1px);
        }

        .meta {
            color: var(--muted);
            font-size: 0.9rem;
        }

        .site-footer {
            width: min(100%, 1040px);
            margin: 18px auto 0;
            text-align: center;
            color: var(--muted);
            font-size: 0.9rem;
        }

        @media (max-width: 820px) {
            .page { grid-template-columns: 1fr; }
            .site-header { flex-direction: column; gap: 10px; align-items: flex-start; }
        }
    </style>
</head>
<body>
    <header class="site-header">
        <div class="brand">
            <strong>Internship Submission</strong>
            <span>Task 1 • HTML Structure & Basic Server</span>
        </div>
        <div class="nav-pill">Express • EJS • Form Handling</div>
    </header>

    <main class="page">
        <section class="summary">
            <div class="badge">Submission complete</div>
            <div>
                <h1>Thanks, <%= username %>.</h1>
                <p>Your form was submitted successfully and rendered on the server.</p>
            </div>
            <p class="meta">Task 1 • HTML structure • Express server • EJS rendering</p>
        </section>

        <section class="card">
            <h2><%= title %></h2>

            <div class="detail">
                <div class="row">
                    <span class="label">Name</span>
                    <div class="value"><%= username %></div>
                </div>
                <div class="row">
                    <span class="label">Email</span>
                    <div class="value"><%= email %></div>
                </div>
                <div class="row">
                    <span class="label">Submitted at</span>
                    <div class="value"><%= submittedAt %></div>
                </div>
            </div>

            <div class="toolbar">
                <a class="button" href="/">Submit another response</a>
            </div>
        </section>
    </main>

    <footer class="site-footer">
        Prepared by Archita Guha Roy • Internship Project Submission
    </footer>
</body>
</html>
