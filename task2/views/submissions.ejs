<!DOCTYPE html>
<html lang="en">
<head>
    <title><%= title %></title>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <style>
        :root {
            --bg: #f6f8fc;
            --surface: #ffffff;
            --border: #d9e2ef;
            --text: #142033;
            --muted: #607086;
            --accent: #1d4ed8;
            --soft: #eef4ff;
            --shadow: 0 20px 60px rgba(20, 32, 51, 0.08);
        }
        * { box-sizing: border-box; }
        body {
            margin: 0; min-height: 100vh; font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
            background: linear-gradient(180deg, #eef4ff 0%, var(--bg) 100%); color: var(--text); padding: 28px 18px 34px;
        }
        .topbar, .footer, .page { width: min(100%, 1080px); margin: 0 auto; }
        .topbar {
            display: flex; justify-content: space-between; align-items: center; gap: 16px;
            background: rgba(255,255,255,.9); border: 1px solid var(--border);
            border-radius: 18px; padding: 14px 18px; box-shadow: var(--shadow); backdrop-filter: blur(10px);
        }
        .brand strong { display:block; font-size: 1rem; }
        .brand span, .meta { color: var(--muted); font-size: .9rem; }
        .badge { padding: 9px 12px; border-radius: 999px; background: var(--soft); color: var(--accent); font-weight: 700; }
        .page { margin-top: 18px; background: var(--surface); border: 1px solid var(--border); border-radius: 24px; box-shadow: var(--shadow); padding: 28px; }
        .entry { border: 1px solid var(--border); border-radius: 18px; padding: 16px 18px; margin-top: 12px; background: #fff; }
        .entry strong { display:block; margin-bottom: 8px; }
        .entry span { display:block; color: var(--muted); margin-top: 3px; }
        .footer { margin-top: 18px; text-align: center; color: var(--muted); font-size: .9rem; }
        a { color: var(--accent); text-decoration: none; font-weight: 600; }
        @media (max-width: 860px) { .topbar { flex-direction: column; align-items: flex-start; } }
    </style>
</head>
<body>
    <header class="topbar">
        <div class="brand">
            <strong>Cognifyz Internship Task 2</strong>
            <span>Temporary in-memory storage</span>
        </div>
        <div class="badge"><%= submissions.length %> entries</div>
    </header>

    <main class="page">
        <h2 style="margin-top:0;"><%= title %></h2>
        <p class="meta">These entries stay only while the server is running.</p>
        <% if (!submissions.length) { %>
            <p>No submissions yet. <a href="/">Go back to the form</a>.</p>
        <% } else { %>
            <% submissions.forEach((submission, index) => { %>
                <div class="entry">
                    <strong>#<%= index + 1 %> • <%= submission.fullName %></strong>
                    <span>Email: <%= submission.email %></span>
                    <span>Phone: <%= submission.phone %></span>
                    <span>Course: <%= submission.course %></span>
                    <span>Submitted at: <%= submission.submittedAt %></span>
                </div>
            <% }) %>
        <% } %>
    </main>

    <footer class="footer">Prepared by Archita Guha Roy • Cognifyz Internship Task 2</footer>
</body>
</html>
