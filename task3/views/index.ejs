<!DOCTYPE html>
<html lang="en">
<head>
    <title><%= title %></title>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        :root {
            --bg: #08111f;
            --bg-2: #0d1a31;
            --accent: #7c9cff;
            --accent-2: #8b5cf6;
        }

        html { scroll-behavior: smooth; }
        body {
            background:
                radial-gradient(circle at top left, rgba(124, 156, 255, 0.14), transparent 30%),
                radial-gradient(circle at bottom right, rgba(139, 92, 246, 0.12), transparent 28%),
                linear-gradient(160deg, var(--bg), var(--bg-2));
            color: #eef2ff;
            overflow-x: hidden;
        }

        section { scroll-margin-top: 96px; }

        .navbar {
            backdrop-filter: blur(18px);
            background: rgba(8, 17, 31, 0.72) !important;
            border-bottom: 1px solid rgba(255, 255, 255, 0.08);
        }

        .navbar-nav .nav-link {
            color: rgba(238, 242, 255, 0.82);
        }

        .navbar-nav .nav-link:hover,
        .navbar-nav .nav-link:focus {
            color: #ffffff;
        }

        .navbar-toggler {
            border-color: rgba(255, 255, 255, 0.22);
        }

        .hero {
            min-height: 88vh;
            display: flex;
            align-items: center;
            padding-top: 4rem;
            padding-bottom: 4rem;
        }

        .glass {
            background: rgba(255, 255, 255, 0.08);
            border: 1px solid rgba(255, 255, 255, 0.12);
            box-shadow: 0 25px 80px rgba(0, 0, 0, 0.3);
            backdrop-filter: blur(18px);
        }

        .badge-soft {
            background: rgba(124, 156, 255, 0.16);
            color: #dce6ff;
            border: 1px solid rgba(124, 156, 255, 0.24);
        }

        .display-4, .section-title {
            letter-spacing: -0.04em;
        }

        .btn-gradient {
            background: linear-gradient(135deg, var(--accent), var(--accent-2));
            border: 0;
            color: white;
            box-shadow: 0 18px 40px rgba(124, 156, 255, 0.22);
            transition: transform 180ms ease, box-shadow 180ms ease, filter 180ms ease;
        }

        .btn-gradient:hover {
            color: white;
            transform: translateY(-2px);
            box-shadow: 0 20px 44px rgba(124, 156, 255, 0.3);
            filter: brightness(1.03);
        }

        .feature-card {
            height: 100%;
            transition: transform 220ms ease, box-shadow 220ms ease, border-color 220ms ease;
        }

        .feature-card:hover {
            transform: translateY(-8px);
            box-shadow: 0 24px 60px rgba(0, 0, 0, 0.22);
            border-color: rgba(124, 156, 255, 0.35);
        }

        .icon-wrap {
            width: 56px;
            height: 56px;
            border-radius: 16px;
            display: grid;
            place-items: center;
            background: rgba(124, 156, 255, 0.14);
            color: #dce6ff;
            font-size: 1.4rem;
        }

        .timeline {
            border-left: 2px solid rgba(124, 156, 255, 0.35);
            padding-left: 18px;
        }

        .timeline-item {
            position: relative;
            margin-bottom: 22px;
        }

        .timeline-item::before {
            content: "";
            position: absolute;
            left: -26px;
            top: 7px;
            width: 12px;
            height: 12px;
            border-radius: 50%;
            background: linear-gradient(135deg, var(--accent), var(--accent-2));
            box-shadow: 0 0 0 6px rgba(124, 156, 255, 0.12);
        }

        .floating {
            animation: floaty 5s ease-in-out infinite;
        }

        @keyframes floaty {
            0%, 100% { transform: translateY(0px); }
            50% { transform: translateY(-10px); }
        }

        .reveal {
            animation: fadeUp 0.8s ease both;
        }

        .delay-1 { animation-delay: 0.08s; }
        .delay-2 { animation-delay: 0.16s; }
        .delay-3 { animation-delay: 0.24s; }

        @keyframes fadeUp {
            from { opacity: 0; transform: translateY(18px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .stat {
            border-top: 1px solid rgba(255,255,255,0.08);
            padding-top: 1rem;
        }

        footer {
            color: rgba(238, 242, 255, 0.72);
        }

        @media (max-width: 991.98px) {
            .hero .row {
                gap: 2rem !important;
            }

            .hero {
                min-height: auto;
                padding-top: 3rem;
                padding-bottom: 3rem;
            }

            .col-lg-6 {
                width: 100%;
            }

            .navbar-collapse {
                margin-top: 0.75rem;
                padding: 0.75rem 0 0.25rem;
                border-top: 1px solid rgba(255, 255, 255, 0.08);
            }

            .navbar-nav {
                gap: 0.25rem !important;
            }

            .navbar-nav .nav-link {
                padding-left: 0;
                padding-right: 0;
            }
        }

        @media (max-width: 575.98px) {
            .container {
                padding-left: 1rem;
                padding-right: 1rem;
            }

            .display-4 {
                font-size: calc(1.425rem + 3vw);
            }

            .glass {
                border-radius: 1.5rem;
            }

            .btn {
                width: 100%;
            }

            .d-flex.gap-3.flex-wrap {
                gap: 0.75rem !important;
            }
        }
    </style>
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark sticky-top">
        <div class="container py-2">
            <a class="navbar-brand fw-semibold" href="#overview">Cognifyz Task 3</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navMenu" aria-controls="navMenu" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navMenu">
                <ul class="navbar-nav ms-auto gap-lg-3">
                    <li class="nav-item"><a class="nav-link" href="#overview">Overview</a></li>
                    <li class="nav-item"><a class="nav-link" href="#sections">Sections</a></li>
                    <li class="nav-item"><a class="nav-link" href="#responsive">Responsive</a></li>
                </ul>
            </div>
        </div>
    </nav>

    <section class="hero" id="overview">
        <div class="container">
            <div class="row align-items-center g-5">
                <div class="col-lg-6 reveal">
                    <span class="badge badge-soft rounded-pill px-3 py-2 mb-3">Advanced CSS • Responsive UI</span>
                    <h1 class="display-4 fw-bold mb-3">A polished multi-section layout with modern motion and Bootstrap.</h1>
                    <p class="lead text-white-50 mb-4">
                        This task focuses on advanced styling, responsive structure, and a consistent UI system across devices.
                    </p>
                    <div class="d-flex gap-3 flex-wrap">
                        <a href="#sections" class="btn btn-gradient btn-lg px-4">Explore sections</a>
                        <a href="#responsive" class="btn btn-outline-light btn-lg px-4">See responsiveness</a>
                    </div>
                </div>
                <div class="col-lg-6 reveal delay-1">
                    <div class="glass rounded-5 p-4 p-md-5 floating">
                        <div class="d-flex justify-content-between align-items-start mb-4">
                            <div>
                                <div class="text-white-50 small text-uppercase">UI Snapshot</div>
                                <h2 class="h3 fw-bold mb-0">Bootstrap + custom layers</h2>
                            </div>
                            <span class="badge badge-soft rounded-pill">Live</span>
                        </div>
                        <div class="row g-3">
                            <div class="col-6">
                                <div class="glass rounded-4 p-3 stat">
                                    <div class="fw-bold fs-4">04</div>
                                    <div class="text-white-50 small">Sections</div>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="glass rounded-4 p-3 stat">
                                    <div class="fw-bold fs-4">100%</div>
                                    <div class="text-white-50 small">Responsive</div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section class="py-5" id="sections">
        <div class="container">
            <div class="row g-4">
                <div class="col-12">
                    <h2 class="section-title fw-bold mb-2 reveal">Multiple sections, clean spacing, consistent design.</h2>
                    <p class="text-white-50 reveal delay-1">Each section uses Bootstrap grids with custom styling for a polished internship submission.</p>
                </div>
                <div class="col-md-4 reveal delay-1">
                    <div class="card feature-card glass text-white rounded-4 p-4">
                        <div class="icon-wrap mb-3">✦</div>
                        <h3 class="h5 fw-bold">Hero Section</h3>
                        <p class="text-white-50 mb-0">Strong visual hierarchy with CTA buttons and a responsive two-column layout.</p>
                    </div>
                </div>
                <div class="col-md-4 reveal delay-2">
                    <div class="card feature-card glass text-white rounded-4 p-4">
                        <div class="icon-wrap mb-3">↗</div>
                        <h3 class="h5 fw-bold">Cards & Motion</h3>
                        <p class="text-white-50 mb-0">Hover transitions, floating effects, and layered glass surfaces for depth.</p>
                    </div>
                </div>
                <div class="col-md-4 reveal delay-3">
                    <div class="card feature-card glass text-white rounded-4 p-4">
                        <div class="icon-wrap mb-3">☰</div>
                        <h3 class="h5 fw-bold">Bootstrap Grid</h3>
                        <p class="text-white-50 mb-0">Responsive columns automatically adapt from mobile to desktop breakpoints.</p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section class="py-5" id="responsive">
        <div class="container">
            <div class="row g-4 align-items-center">
                <div class="col-lg-6 reveal">
                    <div class="glass rounded-5 p-4 p-md-5">
                        <h2 class="fw-bold mb-4">Responsive design highlights</h2>
                        <div class="timeline">
                            <div class="timeline-item">
                                <h3 class="h6 fw-bold mb-1">Mobile-friendly layout</h3>
                                <p class="text-white-50 mb-0">Stacks cleanly on smaller screens with readable spacing.</p>
                            </div>
                            <div class="timeline-item">
                                <h3 class="h6 fw-bold mb-1">Adaptive typography</h3>
                                <p class="text-white-50 mb-0">Uses fluid headings and spacing to stay balanced across devices.</p>
                            </div>
                            <div class="timeline-item mb-0">
                                <h3 class="h6 fw-bold mb-1">Consistent components</h3>
                                <p class="text-white-50 mb-0">Bootstrap ensures predictable spacing, grids, and controls.</p>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-lg-6 reveal delay-1">
                    <div class="glass rounded-5 p-4 p-md-5">
                        <h2 class="fw-bold mb-3">Viewport-ready showcase</h2>
                        <p class="text-white-50 mb-4">This section demonstrates how the same content remains visually balanced on mobile, tablet, and desktop widths.</p>
                        <div class="row g-3">
                            <div class="col-6">
                                <div class="rounded-4 p-4 glass text-center">
                                    <div class="fs-3 fw-bold">sm</div>
                                    <div class="text-white-50 small">Compact</div>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="rounded-4 p-4 glass text-center">
                                    <div class="fs-3 fw-bold">lg</div>
                                    <div class="text-white-50 small">Expanded</div>
                                </div>
                            </div>
                        </div>
                        <div class="mt-4">
                            <a class="btn btn-gradient px-4" href="#overview">Back to top</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <footer class="py-4 text-center">
        Prepared by Archita Guha Roy • Cognifyz Internship Task 3
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
